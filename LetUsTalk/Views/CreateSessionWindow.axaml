<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LetUsTalk.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="LetUsTalk.Views.CreateSessionWindow"
        x:DataType="vm:CreateSessionWindowViewModel"
        Title="Create Session"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:CreateSessionWindowViewModel/>
    </Design.DataContext>

    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
              RowSpacing="12">
            <TextBlock Text="Create a session"
                       Grid.Row="0"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Enter a session name or generate one automatically."
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBox Grid.Column="0"
                         Text="{Binding Path=CreateSessionModalWindowComponent.SessionComponent.SessionName, Mode=TwoWay}"
                         Watermark="Session name"
                         HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1"
                        Content="Generate"
                        MinWidth="96"
                        HorizontalContentAlignment="Center"
                        Command="{Binding Path=CreateSessionModalWindowComponent.GenerateCommand}"/>
            </Grid>
            <TextBlock Text="{Binding Path=CreateSessionModalWindowComponent.SessionComponent.ValidationMessage}"
                       Grid.Row="3"
                       Foreground="#FF6B6B"
                       IsVisible="{Binding Path=CreateSessionModalWindowComponent.SessionComponent.HasValidationMessage}"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12"
                        Margin="0,8,0,0">
                <Button Content="Create"
                        Background="#2E8B57"
                        Foreground="White"
                        MinWidth="100"
                        HorizontalContentAlignment="Center"
                        Command="{Binding Path=CreateSessionModalWindowComponent.CreateCommand}"/>
                <Button Content="Cancel"
                        Background="#C0392B"
                        Foreground="White"
                        MinWidth="100"
                        HorizontalContentAlignment="Center"
                        Command="{Binding Path=CreateSessionModalWindowComponent.CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
