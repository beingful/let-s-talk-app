<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LetUsTalk.App"
             xmlns:local="using:LetUsTalk"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="BitcountSingle">avares://LetUsTalk/Assets/Fonts/BitcountSingle.ttf#Bitcount Single</FontFamily>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#39393F" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.4"/>
                    <GradientStop Color="Black" Offset="0.6"/>
                    <GradientStop Color="#39393F" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
